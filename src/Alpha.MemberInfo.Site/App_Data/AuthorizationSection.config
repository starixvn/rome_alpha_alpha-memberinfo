<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H],[L]"
  custIdQueryStringParamNameMapping="custid,CustId,custId,AgentId,SearchAccountId,MasterId"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer,SearchAccountId"
  ignoreUrls=""
  cachedExpireTime="30"
  kickOutUrl="~/default/kickout">
  <!--
    [A]: Create
    [B]: Update
    [C]: Transfer
    [D]: Total Bets
    [E]: Reports
    [F]: Forcast
    [H]: Member Information
    [G]: View Log
    [L]: Bet Lists
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <DeniedPages>
      <add url="DormantAccount" />
    </DeniedPages>
    <PageAccesses>
      <add id="1.01.01" permission="[H]" mainfuncname="Member Information" subfuncname="MemberRequests" url="MemberRequests" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.02" permission="[H]" mainfuncname="Member Information" subfuncname="MemberRequests" url="MemberRequests/Members" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.03" permission="[B]" mainfuncname="Member Information" subfuncname="MemberRequests" url="MemberRequests/EnableProduct" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.02.01" permission="[H]" mainfuncname="Member Information" subfuncname="Credit Balance List" url="CreditBalance" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.03.01" permission="[H]" mainfuncname="Member Info" subfuncname="Win Limit" url="WinLossLimit/Index" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.04.01" permission="[A]" mainfuncname="Create Member QR Code" subfuncname="QRCodeSignIn" url="QRCodeMemberSignIn" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.04.02" permission="[A]" mainfuncname="Create Member QR Code" subfuncname="QRCodeSignIn" url="QRCodeMemberSignIn/CreateAccount" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.04.03" permission="[A]" mainfuncname="Create Member QR Code" subfuncname="QRCodeSignIn" url="QRCodeMemberSignIn/ShowQRCode" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.04.04" permission="[A]" mainfuncname="Create Member QR Code" subfuncname="QRCodeSignIn" url="QRCodeMemberSignIn/GenerateQrCode" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.05.01" permission="[A],[B],[H]" mainfuncname="Member Info" subfuncname="Customer List" url="CustomerList/Index" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.05.02" permission="[A],[B],[H]" mainfuncname="Member Info" subfuncname="Customer List" url="CustomerList/GetCustomerListData" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.05.03" permission="[A],[B],[H]" mainfuncname="Member Info" subfuncname="Customer List" url="CustomerList/GetCustomerAllStatus" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.05.04" permission="[A],[B],[H]" mainfuncname="Member Info" subfuncname="Customer List" url="CustomerList/MultipleEditPopup" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.05.05" permission="[B]" mainfuncname="Member Info" subfuncname="Customer List" url="CustomerList/UpdateCustomerStatus" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.05.06" permission="[A],[B],[H]" mainfuncname="Member Info" subfuncname="Customer List" url="CustomerList/MultipleDoubleComm" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.05.07" permission="[B]" mainfuncname="Member Info" subfuncname="Customer List" url="CustomerList/UpdateMultipleDoubleComm" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.05.08" permission="[H]" mainfuncname="Parlay Max Payout" subfuncname="Edit Single" url="ParlayMaxPayout/EditSingle" ischeckbelonging="true" isallowtodobythemselves="false" />
      <add id="1.05.09" permission="[H]" mainfuncname="Parlay Max Payout" subfuncname="Edit Multiple" url="ParlayMaxPayout/EditMultiple" ischeckbelonging="true" isallowtodobythemselves="false" />
      <add id="1.05.10" permission="[B]" mainfuncname="Parlay Max Payout" subfuncname="Update Single" url="ParlayMaxPayout/UpdateSingle" ischeckbelonging="true" isallowtodobythemselves="false" />
      <add id="1.05.11" permission="[B]" mainfuncname="Parlay Max Payout" subfuncname="Update Multiple" url="ParlayMaxPayout/UpdateMultiple" ischeckbelonging="true" isallowtodobythemselves="false" />
      <add id="1.05.12" permission="[H]" mainfuncname="Parlay Max Payout" subfuncname="Check Downline" url="ParlayMaxPayout/CheckDownline" ischeckbelonging="true" isallowtodobythemselves="false" />
      <add id="1.05.16" permission="[H]" mainfuncname="WinLoss Limit" url="WinLossLimit/Index" ischeckbelonging="true"/>
      <add id="1.05.17" permission="[A],[B],[H]" mainfuncname="Member Info" subfuncname="Customer List" url="CustomerList/Agent" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.05.18" permission="[A],[B],[H]" mainfuncname="Member Info" subfuncname="Customer List" url="CustomerList/Member" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.06.01" permission="[A],[B],[H]" mainfuncname="My Monitor Accounts" subfuncname="ReachedThreshold" url="ReachedThreshold" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.06.02" permission="[A],[B],[H]" mainfuncname="My Monitor Accounts" subfuncname="ReachedThreshold" url="ReachedThreshold/GetReachlistThreshold" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.06.03" permission="[A],[B],[H]" mainfuncname="My Monitor Accounts" subfuncname="ReachedThreshold" url="ReachedThreshold/GetReachHistory" ischeckbelonging="true" isallowtodobythemselves="false" />
      <add id="1.06.04" permission="[A],[B],[H]" mainfuncname="My Monitor Accounts" subfuncname="ReachedThreshold" url="ReachedThreshold/Excel" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.06.05" permission="[A],[B],[H]" mainfuncname="My Monitor Accounts" subfuncname="MyWatchlistAccounts" url="MyWatchlistAccounts" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.06.06" permission="[A],[B],[H]" mainfuncname="My Monitor Accounts" subfuncname="MyWatchlistAccounts" url="MyWatchlistAccounts/GetWatchlistAccounts" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.06.07" permission="[B]" mainfuncname="My Monitor Accounts" subfuncname="MyWatchlistAccounts" url="MyWatchlistAccounts/AddPersonalThreshold" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.06.08" permission="[B]" mainfuncname="My Monitor Accounts" subfuncname="MyWatchlistAccounts" url="MyWatchlistAccounts/UpdateMultiplePersonalThreshold" ischeckbelonging="true" isallowtodobythemselves="false" />
      <add id="1.06.09" permission="[B]" mainfuncname="My Monitor Accounts" subfuncname="MyWatchlistAccounts" url="MyWatchlistAccounts/DeleteMultiplePersonalThreshold" ischeckbelonging="true" isallowtodobythemselves="false" />
      <add id="1.06.10" permission="[B]" mainfuncname="My Monitor Accounts" subfuncname="MyWatchlistAccounts" url="MyWatchlistAccounts/UpdateGlobalThreshold" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.06.11" permission="[B]" mainfuncname="My Monitor Accounts" subfuncname="MyWatchlistAccounts" url="MyWatchlistAccounts/GetPersonalPresets" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.06.12" permission="[B]" mainfuncname="My Monitor Accounts" subfuncname="MyWatchlistAccounts" url="MyWatchlistAccounts/AddMultiplePersonalPreset" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.06.13" permission="[B]" mainfuncname="My Monitor Accounts" subfuncname="MyWatchlistAccounts" url="MyWatchlistAccounts/UpdatePersonalPreset" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.06.14" permission="[B]" mainfuncname="My Monitor Accounts" subfuncname="MyWatchlistAccounts" url="MyWatchlistAccounts/DeletePersonalPreset" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.06.15" permission="[B]" mainfuncname="My Monitor Accounts" subfuncname="MyWatchlistAccounts" url="MyWatchlistAccounts/ManageWatchlistAccounts" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.06.16" permission="[B]" mainfuncname="My Monitor Accounts" subfuncname="MyWatchlistAccounts" url="MyWatchlistAccounts/ManageGlobalThreshold" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.06.17" permission="[B]" mainfuncname="My Monitor Accounts" subfuncname="MyWatchlistAccounts" url="MyWatchlistAccounts/ManagePersonalThresholdPreset" ischeckbelonging="false" isallowtodobythemselves="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <DeniedPages>
      <add url="QRCodeMemberSignIn" />
      <add url="ReachedThreshold" />
      <add url="MyWatchlistAccounts" />
    </DeniedPages>
    <PageAccesses>
      <add id="1.05.01" permission="[H]" mainfuncname="Member Information" subfuncname="Dormant Account List" url="DormantAccount" ischeckbelonging="false" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <DeniedPages>
      <add url="QRCodeMemberSignIn" />
      <add url="ReachedThreshold" />
      <add url="MyWatchlistAccounts" />
    </DeniedPages>
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>