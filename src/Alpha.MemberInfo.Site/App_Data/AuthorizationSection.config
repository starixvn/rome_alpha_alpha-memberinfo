<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H],[L]"
  custIdQueryStringParamNameMapping="custid,CustId,custId,AgentId,SearchAccountId,MasterId,selectedCustId"
