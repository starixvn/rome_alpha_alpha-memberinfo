@model CopyAccountViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.SearchAndCopy;
    var errorMessageClass = string.IsNullOrEmpty(Model.ErrorMessage) ? "hidden" : "msg msg-error";
}

@section Styles {
    @StaticResources.RenderStylesWithDarkMode("~/Features/CopyAccount/Bundles/copy-account")
}

<div class="tab-content">
    <div role="tabpanel" class="tab-pane active">
        @if (Model.IsLimitNewDownline)
        {
            <div class="@errorMessageClass">
                <span className="col-xs-12">@Model.ErrorMessage</span>
            </div>
        }
        else
        {
            <form id="copyAccountForm" class="form-validation">
                <div id="message" class="@errorMessageClass">
                    <span id="message-content" className="col-xs-12">@Model.ErrorMessage</span>
                </div>
                <div id="create-form">
                    <p class="note">@Resources.CopyAccountNote</p>
                    <div class="switch-old-version">
                        <a href="#" class="btn-switch-version">
                            <span class="icon-refresh2"></span>
                            Switch to old version
                        </a>
                    </div>


                    <h4 class="title">@Resources.CopySettings</h4>
                    <div class="form-group">
                        <label class="label">@Resources.CopySettingsNote</label>
                        <input type="text" name="SourceUsername" id="SourceUsername" placeholder="@Resources.UsernamePlaceHolder" value="@Model.SourceUsername" />
                        <span id="icon-message-SourceUsername" />
                    </div>

                    <h4 class="title">@Resources.NoOfAccounts</h4>
                    <div class="form-group">
                        <label class="label">@string.Format(Resources.NoOfAccountsNote, AppSettings.MaxAccountsCreatePerRequest)</label>
                        <input type="number" name="NoOfAccounts" id="NoOfAccounts" min="1" max="@AppSettings.MaxAccountsCreatePerRequest" />
                        <span id="icon-message-NoOfAccounts" />
                    </div>

                    <h4 class="title">@Resources.AccountDetails</h4>
                    <label class="label">@Resources.AccountDetailsNote</label>
                    <div class="form-group" id="username-group">
                        <label class="sub-label">@Resources.Username <span class="require">*</span></label>
                        <span id="actor-name">@Model.ActorUsername</span>
                        <select id="FirstSuffix" name="FirstSuffix">
                            @foreach (var item in Model.NameSuffix)
                            {
                                <option value="@item" @(Model.FirstChar.Equals(item) ? "selected=\"selected\"" : string.Empty)> @item</option>
                            }
                        </select>
                        <select id="SecondSuffix" name="SecondSuffix">
                            @foreach (var item in Model.NameSuffix)
                            {
                                <option value="@item" @(Model.SecondChar.Equals(item) ? "selected=\"selected\"" : string.Empty)> @item</option>
                            }
                        </select>
                        @if (Model.ActorLevel.IsAgentLevel())
                        {
                            <select id="ThirdSuffix" name="ThirdSuffix">
                                @foreach (var item in Model.NameSuffix)
                                {
                                    <option value="@item" @(Model.ThirdChar.Equals(item) ? "selected=\"selected\"" : string.Empty)> @item</option>
                                }
                            </select>
                        }
                        <span id="icon-message-username" class="icon-check" />
                    </div>

                    <div class="form-group">
                        <label class="sub-label">@Resources.Credit <span class="require">*</span></label>
                        <input type="text" name="Credit" id="Credit" value="" />
                        <span class="per-account">(per account)</span>
                        <span id="icon-message-credit"> </span>
                        <div id="credit-range" class="hidden">
                            <span id="credit-min-label"></span> <=  @Resources.NewGivenCredit <= <span id="credit-max-label"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>@Resources.Password <span class="require">*</span> <span class="icon-information-outline" title="@Resources.lblPasswordRequire"></span></label>
                        <input type="password" name="Password" id="Password" autocomplete="off" maxlength="16" />
                        <span id="icon-message-password"> </span>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn-submit" id="btn-submit" disabled>@Resources.CreateAccount</button>
                    </div>
                </div>
                @Html.Hidden("SourceUsernameHidden", Model.SourceUsername)
                @Html.Hidden("MaxAccountsCreatePerRequest", AppSettings.MaxAccountsCreatePerRequest)
                <input type="hidden" id="member-info-url" value="@MicroSites.MemberInfoUrl()" />
                @Html.AntiForgeryToken()
            </form>

            <form class="old-version">
                <p class="old-version-text">The list of accounts been created successfully: </p>
                <div class="switch-old-version">
                    <a href="#" class="btn-switch-version">
                        <span class="icon-refresh2"></span>
                        Switch to old version
                    </a>
                </div>
                <p class="old-version-text">Usernames: <span class="txt-bold"> Master01001, Master01002, Master01003, Master01004 </span>  <span class="icon icon-content-copy"></span></p>
                <p class="old-version-text">Credit: <span class="txt-bold">1,000.00</span> (per account)</p>
                <div class="form-group">
                    <button type="submit" class="btn-submit" id="btn-submit" disabled>@Resources.CreateAccount</button>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    @StaticResources.AssetScripts.Render("/bundles/site-asset/numeral")
    @StaticResources.RenderScripts("~/Features/CopyAccount/Bundles/copy-account")
}