@model CopyAccountResponse
<p class="msg msg-success msg-result">The list of accounts has been created successfully</p>
<div class="form-group">
    <label>@Resources.Usernames:</label>
    <div class="relative-input result-input">
        <input type="text" name="member" id="usernames" value="@string.Join(", ", Model.Usernames)" />
        <span class="icon icon-content-copy" data-clipboard-target="#usernames" data-clipboard-action="copy"></span>
    </div>
</div>
<div class="form-group">
    <label class="sub-label">@Resources.Credit <span class="require">*</span></label>
    <div class="relative-input result-input">    
        <input type="text" name="Credit" id="txtClonedCredit" value="@Model.Credit.ToString("0,0.##")" />
        <span class="per-account">(@Resources.PerAccount)</span>
    </div>
</div>

@*<p class="result-text">@Resources.CreateCustomerSuccessMessage: </p>
@Html.Partial("~/Features/CopyAccount/Views/_SwitchToOldVersion.cshtml")
<p class="result-text">@Resources.Usernames: <span class="txt-bold" id="usernames">@string.Join(", ", Model.Usernames)</span>  <span class="icon icon-content-copy" data-clipboard-target="#usernames" data-clipboard-action="copy"></span></p>
<p class="result-text">@Resources.Credit: <span class="txt-bold" id="txtClonedCredit">@Model.Credit.ToString("0,0.##")</span> <span class="per-account">(@Resources.PerAccount)</span></p>*@
@if (Model.NoOfFailedAccount > 0)
{
    <div class="failed-account-created">
        <p class="msg msg-error">@Model.Message</p>
        <p class="result-text">@Resources.FailureReason: <span>@string.Format(Resources.NoAccountCreatedFailed, Model.NoOfFailedAccount)</span></p>
    </div>
}
<div class="form-group result-submit">
    <button class="btn-submit" id="btnCreateMore">@Resources.CreateMore</button>
</div>