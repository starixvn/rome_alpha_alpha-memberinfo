@model CreateAccountViewModel
@{
    Layout = "~/Features/CreateAccount/Views/_Layout.cshtml";
}

@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode($"/bundles/common/common-{Model.CustLevel}")
    @StaticResources.RenderStyles("~/Features/CreateAccount/bundles/quick-introduction")
}

<div class="page-title">@Model.PageTitle</div>
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation">
        @Html.ActionLink(Resources.SearchAndCopy, "Index", "CopyAccount")
    </li>
    <li role="presentation">
        <a href="@MicroSites.OldMainUrl("~/_MemberInfo/SearchAndCopy/MasterPage.aspx")" role="tab" data-toggle="tab">@Resources.FullMode</a>
    </li>
    @if (Model.IsCreateMember)
    {
        <li class="has-icon" role="presentation">
            @Html.ActionLink(Resources.QRCode, "Index", "QRCodeMemberSignIn")
            <a id="qr-info" href="/site-messages/StaticMessage/File?id=129373" target="_blank" class="icon-information-outline"></a>
        </li>
    }
    <li role="presentation" class="new-function active">
        <a href="javascript:;" aria-controls="home" role="tab" data-toggle="tab">@Resources.LiteMode</a>
        <span class="bage-new">New</span>
    </li>
</ul>
@Html.Action("QuickIntroduction", "Introduction")
@if (Model.IsLimitNewDownline)
{
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane active">
            <div class="msg msg-error">
                <span className="col-xs-12">@Model.ErrorMessage</span>
            </div>
        </div>
    </div>
}
else
{
    @Html.AntiForgeryToken()
    <div id="root" style="height:100%"></div>
    @section Scripts{
        @if (AppSettings.DevelopmentEnvironment)
        {
            <!-- if development -->
            <script type="module" src="http://localhost:5173/src/pages/createAccount.tsx"></script>
        }
        else
        {
            <!-- if production -->
            <link rel="stylesheet" href="~/ClientApp/dist/assets/createAccount-7aaa218c.css" />
            <script type="module" src="~/ClientApp/dist/assets/createAccount-a606c5fd.js"></script>
        }
    }
}
@StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
@StaticResources.RenderScripts("~/Features/CreateAccount/bundles/quick-introduction")