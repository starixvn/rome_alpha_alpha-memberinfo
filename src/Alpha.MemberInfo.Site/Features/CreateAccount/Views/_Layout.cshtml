<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewBag.Title ?? "Alpha - Member Information")</title>
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-memberinfo/default")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/default")
    @RenderSection("Styles", required: false)
</head>
<body style="height:100%">
    <noscript>You need to enable JavaScript to run this app.</noscript>
    @RenderBody()
    @if (AppSettings.DevelopmentEnvironment)
    {
        <!-- if development -->
        <script type="module" src=@("http://localhost:5173/@vite/client")></script>
    }
    else
    {
        <!-- if production -->

        <link rel="stylesheet" href="~/ClientApp/dist/assets/index-06d353a9.css" />
        <script type="module" src="~/ClientApp/dist/assets/index-8dfb63e2.js"></script>
        <script type="module" src="~/ClientApp/dist/assets/Trans-c823c5de.js"></script>
        <link rel="stylesheet" href="~/ClientApp/dist/assets/PTSelect-13f830b9.css" />
        <script type="module" src="~/ClientApp/dist/assets/PTSelect-de37a276.js"></script>
    }
    @RenderSection("Scripts", required: false)
</body>
</html>