@model IEnumerable<ISettingItemMultipleViewModel>

@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	ViewBag.Title = "Edit Popup";
}

@section Styles {
	@StaticResources.AssetStyles.RenderCommon("/bundles/site-asset/data-table")
<style>
	li {
		padding: 5px;
	}
	</style>
}

<div>
	<ul>
		@foreach (var item in Model)
		{
			if (item.Visible)
			{
				<li class="edit-popup" data-url="@item.Url">
					@item.Text
				</li>
			}
		}

	</ul>
</div>

@section Scripts {
	@*@StaticResources.AssetScripts.RenderCommon("/bundles/site-asset/data-table")

		@StaticResources.RenderScripts("~/Features/CustomerList/Bundles/master-list")*@

	<script>
		function productPopupOnCustomerListOnclosing() {
			window.location = window.location;
		}

		$(document).ready(function () {
			const mainFrame = window.top.$('#main');
			const topBody = mainFrame.parent().parent().parent();

			$(topBody).find('div[id^="page-popup-"]').find('.modal-header').addClass('hidden');

			$(topBody).find('div[id^="page-popup-"]').off('mouseleave').on('mouseleave', () => {
				window.top.editPopupOnCustomerList.close();
			})

			$('.edit-popup').click((event) => {
				$(topBody).find('div[id^="page-popup-"]').off('mouseleave');
				$(topBody).find('div[id^="page-popup-"]').find('.modal-header').removeClass('hidden');
				var url = $(event.currentTarget).data("url");
				window.top.popupManager.openWithHanlder(window.top.editPopupOnCustomerList, url, 'EDIT POPUP', 800, 600);
			});
		});
	</script>
}
