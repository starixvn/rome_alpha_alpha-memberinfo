@model CustomerListViewModel

@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	ViewBag.Title = "Customer List";
}

@section Styles {
	@StaticResources.AssetStyles.RenderCommon("/bundles/site-asset/data-table")
	@StaticResources.RenderStyles("~/Features/CustomerList/Bundles/customer-list")
	@*<link rel="stylesheet" type="text/css"  href="https://cdn.datatables.net/scroller/2.0.0/css/scroller.dataTables.css" />*@
}
<div class="page-title">

	@if (!string.IsNullOrWhiteSpace(Model.PageTitle))
	{
		<span class="text-title pull-left">
			@Model.PageTitle
		</span>
	}

	@if (!string.IsNullOrWhiteSpace(Request.Url.Query))
	{
		@Breadcrumb.Render(new BreadcrumbLevelViewModel(Model.BreadcrumbLevel, Model.BreadcrumbLevelJson), Request.Url.Query, null)
	}

</div>

<div class="form-inline filter form-report" style="margin-top:15px;">
	<div class="form-group">
		<label>Username</label>
		<input type="text" class="txt-search" id="txt-username" placeholder="Username/Nickname or First/Last Name"/>
	</div>
	<div class="form-group">
		<label>Status</label>
		<select id="statusFilter" name="statusFilter">
			@foreach (var option in Model.StatusOptions)
			{
				<option value="@option.Value" selected="@option.Value.Equals(Model.Status)">@option.Text</option>
			}
		</select>
	</div>
	<div class="form-group">
		<label>Double Comm</label>
		<select id="dcommFilter" name="dcommFilter">
			@foreach (var option in Model.DoubleCommOptions)
			{
				<option value="@option.Value" selected="@option.Value.Equals(Model.DoubleComm)">@option.Text</option>
			}
		</select>
	</div>
	<div class="form-group">
		<label>Unconfirmed Setting</label>
		<select id="unconfirmSettingFilter" name="unconfirmSettingFilter">
			@foreach (var option in Model.UnconfirmedSettingOptions)
			{
				<option value="@option.Value" selected="@option.Value.Equals(Model.UnconfirmSetting)">@option.Text</option>
			}
		</select>
	</div>
	<div class="form-group">
		<input type="submit" value="@Resources.Submit" class="btn-submit" />
	</div>
</div>
<div>
	<table id="customer-list" class="hidden tblRpt tblRpt-bordered tblRpt-hover display nowrap" style="width:100%">
		<thead>
			<tr>
				<th data-priority="0"></th>
				@{
					for (var i = 2; i <= (Model.HideEditMultiple ? 14 : 15); i++)
					{
						<th class="@(i >= (Model.HideEditMultiple ? 8 : 9) && i <= (Model.HideEditMultiple ? 14 : 15) ? "desktop" : string.Empty)"></th>
					}
				}
				<th></th>
			</tr>
			<tr>
				<th rowspan="2" class="header">
					No.
				</th>
				@if (!Model.HideEditMultiple)
				{
					<th rowspan="2" class="header">
						<div class="edit-multiple icon-view-grid" data-url=""/>
					</th>
				}
				<th rowspan="2" class="header">
					Username <br />
					NickName
				</th>
				<th rowspan="2" class="header">
					Status
				</th>
				<th rowspan="2" class="header">
					Edit
				</th>
				<th rowspan="2" class="header">
					Statement
				</th>
				<th rowspan="2" class="header">
					First Name
				</th>
				<th rowspan="2" class="header">
					Last Name
				</th>
				<th colspan="6" class="header desktop">
					Commission
				</th>
				<th rowspan="2" class="header">
					Created Date
				</th>
				<th rowspan="2" class="header">
					Login Ip
				</th>
				<th rowspan="2" class="header"></th>
			</tr>
			<tr class="thead-row2">
				@if (Model.ActorRoleId == 2)
				{
					@RenderMemberHeader()
				}
				else
				{
					@RenderMasterAgentHeader()
				}
			</tr>
		</thead>
	</table>

	@Html.AntiForgeryToken()

	<div class="modal modal-sm fade" id="bootstrap-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<div class="modal-body">
				</div>
			</div>
		</div>
	</div>
</div>

<input type="hidden" id="actorId" value="@Model.ActorId">
<input type="hidden" id="actorName" value="@Model.ActorName">
<input type="hidden" id="actorRoleId" value="@Model.ActorRoleId">
<input type="hidden" id="searchAccountId" value="@Model.SearchAccountId">
<input type="hidden" id="searchAccountName" value="@Model.SearchAccountName">
<input type="hidden" id="searchAccountRoleId" value="@Model.SearchAccountRoleId">
<input type="hidden" id="downlineLevelName" value="@Model.DownlineLevelName">
<input type="hidden" id="showEditMultiple" value='@(Model.HideEditMultiple ? "false" : "true" )'>
<input type="hidden" id="isMobileView" value='@(Model.IsMobileView ? "true" : "false" )'>
<input type="hidden" id="breadcrumbLevelJson" value='@Model.BreadcrumbLevelJson'>
<input type="hidden" id="oldMainUrl" value='@MicroSites.OldMainUrl()'>
<input type="hidden" id="reportsUrl" value='@MicroSites.ReportsUrl()'>
<input type="hidden" id="memberInfoUrl" value='@MicroSites.MemberInfoUrl()'>
<input type="hidden" id="accountInfoUrl" value='@MicroSites.AccountInfoUrl()'>
<input type="hidden" id="arrayCustID" name="arrayCustID" value=''>
<input type="hidden" id="arrayUserName" name="arrayUserName" value=''>
<input type="hidden" id="arrayStatusRnCasino" name="arrayStatusRnCasino" value=''>

@section Scripts {
	@StaticResources.AssetScripts.RenderCommon("/bundles/site-asset/data-table")
	@*<script type="text/javascript" src="https://cdn.datatables.net/scroller/2.0.2/js/dataTables.scroller.js"></script>*@
	<script type="text/javascript" src="https://cdn.datatables.net/plug-ins/1.10.20/pagination/input.js"></script>
	@StaticResources.RenderScripts("~/Features/CustomerList/Bundles/customer-list")
}


@helper RenderMasterAgentHeader()
{
	<th class="header desktop">
		Group A
	</th>
	<th class="header desktop">
		Group B
	</th>
	<th class="header desktop">
		Group C
	</th>
	<th class="header desktop">
		Group D
	</th>
	<th class="header desktop">
		1 X 2
	</th>
	<th class="header desktop">
		Other
	</th>
}

@helper RenderMemberHeader()
{
	<th class="header desktop">
		A Comm 1
	</th>
	<th class="header desktop">
		A Comm 2
	</th>
	<th class="header desktop">
		A Comm 3
	</th>
	<th class="header desktop">
		P Comm 1
	</th>
	<th class="header desktop">
		P Comm 2
	</th>
	<th class="header desktop">
		P Comm 3
	</th>
}