@model MemberBettingBehaviorViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Member Betting Behavior";
}

@section Styles {
    @StaticResources.AssetStyles.RenderCommon("/bundles-v2/site-memberinfo/member-betting-behavior")
    @StaticResources.RenderStylesWithDarkMode("~/Features/MemberBettingBehavior/Bundles/member-betting-behavior")
}

@section Scripts {
    @StaticResources.AssetScripts.Render("/bundles-v2/site-asset/chart_v4.4.2")
    @StaticResources.AssetScripts.Render("/bundles-v2/site-memberinfo/member-betting-behavior")
    @StaticResources.RenderScripts("~/Features/MemberBettingBehavior/Bundles/member-betting-behavior")
}


<div class="page-title">@Resources.MemberBettingBehavior</div>

@using (Html.BeginForm("Excel", "MemberBettingBehavior", FormMethod.Get, new { id = "export-excel-form" }))
{
    <input type="hidden" name="username" id="txt-username-hidden" />
    <input type="hidden" name="dateRange" id="date-range-hidden">
}

<div class="filter">
    <div class="form">
        <input type="text" name="username" id="txt-username" autocomplete="off" maxlength="50" />
    </div>
    <button class="btn-submit" id="btn-submit">@Resources.Submit</button>
</div>

<div id="customer-profile" hidden class="box-member">
    <div class="ttl-box-member">@Resources.CustomerProfile</div>
    <div class="body-box-member body-box-member-profile">
        <div class="item">
            <div class="left-icon">
                <span class="icon-account-circle"></span>
            </div>
            <div>
                <div class="info">@Resources.Status</div>
                <div class="value" id="customer-status"></div>
            </div>
        </div>
        <div class="item">
            <div class="left-icon">
                <span class="icon-bell"></span>
            </div>
            <div>
                <div class="info">@Resources.Level</div>
                <div class="value" id="customer-level"></div>
            </div>
        </div>
        <div class="item">
            <div class="left-icon">
                <span class="icon-link"></span>
            </div>
            <div>
                <div class="info">@Resources.RelatedToOtherAccounts</div>
                <div class="value" id="customer-related-account"></div>
            </div>
        </div>
        <div class="item" id="monitored-item">
            <div class="left-icon">
                <span class="icon-mywatchlist"></span>
            </div>
            <div class="">
                <div class="info">@Resources.MonitoredMember</div>
                <div class="value" id="monitored-member"></div>
            </div>
        </div>
        <div class="item">
            <div class="left-icon">
                <span class="icon-alert"></span>
            </div>
            <div class="">
                <div class="info">@Resources.ProblemAccount</div>
                <div class="value" id="problem-account"></div>
            </div>
        </div>
    </div>
</div>


<div class="box-member" id="statisticId" hidden>
    <div class="ttl-box-member">@Resources.BettingStatistic</div>
    <div class="body-box-member body-box-member-chart">
        <div class="statistics">
            <div class="range">
                <div class="form-group">
                    <div class="label">
                        <label>@Resources.DateRange</label>
                        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
                    </div>
                    @Html.DropDownList("DateRangeId", Model.DateRange)
                </div>

            </div>
            <div id="summary-statistic" hidden>
                <div class="item">
                    <div id="summary-turnover" class="number">73.1K</div>
                    <div class="text">@Resources.Turnover</div>
                </div>
                <div class="item">
                    <div id="summary-winloss" class="number">-21.9K</div>
                    <div class="text">@Resources.WinLoss</div>
                </div>
                <div class="item">
                    <div id="summary-margin" class="number">-30%</div>
                    <div class="text">@Resources.Margin</div>
                </div>
                <div class="item">
                    <div id="summary-betcount" class="number">66</div>
                    <div class="text">@Resources.BetCount</div>
                </div>
            </div>

        </div>
        <div class="chart">
            <div class="turnover-by-sport-chart">
                <canvas id="canvas-turnover-by-sport-chart" aria-label="@Resources.TurnoverBySport" role="img">
                    <p>@Resources.NoInformationIsAvailable</p>
                </canvas>
            </div>
            <div class="turnover-by-bettype-chart">
                <canvas id="canvas-turnover-by-bettype-chart" aria-label="@Resources.TurnoverByBetType"
                        data-live="@Resources.Live" data-nonlive="@Resources.NonLive" data-mix="@Resources.Mix" role="img">
                    <p>@Resources.NoInformationIsAvailable</p>
                </canvas>
            </div>
            <div class="turnover-winloss-by-date-chart">
                <canvas id="canvas-turnover-winloss-by-date-chart" aria-label="@Resources.TurnoverAndWinLossByDate"
                        data-turnover="@Resources.Turnover" data-winloss="@Resources.WinLoss" role="img">
                    <p>@Resources.NoInformationIsAvailable</p>
                </canvas>
            </div>
        </div>

    </div>
</div>

<input type="hidden" id="member-info-url" value="@MicroSites.MemberInfoUrl()" />
<input type="hidden" id="mustEnterUserNameText" value="@Resources.MustEnterUsernameError" />
<input type="hidden" id="memberUserNameIsInvalidText" value="@Resources.MemberUsernameIsInvalid" />
<input type="hidden" id="yesText" value="@Resources.Yes" />
<input type="hidden" id="noText" value="@Resources.No2" />

