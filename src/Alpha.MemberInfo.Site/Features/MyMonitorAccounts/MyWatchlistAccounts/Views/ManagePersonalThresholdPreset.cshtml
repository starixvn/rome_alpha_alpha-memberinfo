@model ManagePersonalThresholdPresetViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Manage Personal Threshold Preset";
}

@section Styles {
    @StaticResources.RenderStylesWithDarkMode("~/Features/MyMonitorAccounts/MyWatchlistAccounts/Bundles/manage-presets")
    @StaticResources.RenderStylesWithMedia(767, "~/Features/MyMonitorAccounts/MyWatchlistAccounts/Bundles/manage-presets-media")
}

<div id="manage-preset">
    <div class="alert-message"></div>
    <table id="tbl-report" class="tblRpt tblRpt-bordered alternative-row-table tblRpt-hover" style="width: 100%">
        <thead>
            <tr>
                <th style="width: 55px;">@Resources.No</th>
                <th style="width: 195px;">@Resources.ThresholdPreset</th>
                <th style="width: 210px;">@Resources.WinningThreshold</th>
                <th style="width: 195px;">@Resources.LosingThreshold</th>
                <th style="width: 90px;">@Resources.Action</th>
            </tr>
        </thead>
        <tbody id="table-body">
            @RenderTable()
        </tbody>
    </table>
    <div class="btn-group">
        <button class="btn-submit" id="btn-add">@Resources.AddRow</button>
        <button class="btn-submit" id="btn-save">@Resources.Save</button>
    </div>
</div>

@helper RenderTable()
{
    var index = 0;
    foreach (var preset in Model.PersonalPresets)
    {
        var winningThresholdString = @HtmlHelpers.FormatDecimal(preset.WinningThreshold);
        var losingThresholdString = @HtmlHelpers.FormatDecimal(preset.LosingThreshold);

        <tr id="preset-@index"
            data-index=@index
            data-id=@preset.ID
            data-title=@preset.PresetTitle
            data-winningthresholdstring=@winningThresholdString
            data-losingthresholdstring=@losingThresholdString
            class="preset">
            <td>@(index + 1)</td>
            <td class="preset-title">@preset.PresetTitle</td>
            <td class="winning-threshold">@winningThresholdString</td>
            <td class="losing-threshold">@losingThresholdString</td>
            <td class="action">
                <div class="edit-group">
                    <span class="icon-edit"></span>
                    <span class="icon-bin remove"></span>
                </div>
                <div class="confirm-group hidden">
                    <span class="icon-check"></span>
                    <span class="icon-close"></span>
                </div>
            </td>
        </tr>
        index++;
    }
}

<input type="hidden" id="member-info-url" value='@MicroSites.MemberInfoUrl()'>
<input type="hidden" id="no-change-to-update-error" value="@Resources.NoChangeToUpdateError" />
<input type="hidden" id="are-you-sure-to-remove-preset" value="@Resources.AreYouSureToRemovePreset" />
<input type="hidden" id="add-successfully" value="@Resources.AddSuccessfully" />
<input type="hidden" id="remove-successfully" value="@Resources.RemoveSuccessfully" />
<input type="hidden" id="update-successfully" value="@Resources.UpdateSuccessfully" />
<input type="hidden" id="preset-is-duplicated" value="@Resources.PresetNameIsDuplicated" />

@section Scripts {
    @StaticResources.RenderScripts("~/Features/MyMonitorAccounts/MyWatchlistAccounts/Bundles/manage-presets")
}