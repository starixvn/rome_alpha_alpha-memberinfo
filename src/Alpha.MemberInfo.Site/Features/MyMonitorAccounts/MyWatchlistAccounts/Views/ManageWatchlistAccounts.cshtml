@model ManageWatchlistAccountsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.IsEditWatchlistAccountsPopup ? "Edit Watchlist Account" : "Add New Watchlist Account";
}

@section Styles {
    @StaticResources.RenderStylesWithDarkMode("~/Features/MyMonitorAccounts/MyWatchlistAccounts/Bundles/manage-watchlist-accounts")
    @StaticResources.RenderStylesWithMedia(767, "~/Features/MyMonitorAccounts/MyWatchlistAccounts/Bundles/manage-watchlist-accounts-media")
}

<div id="manage-watchlist-accounts">
    <div class="alert-message"></div>
    @if (Model.IsEditWatchlistAccountsPopup)
    {
        if (Model.Usernames.Split(',').Length > 1)
        {
            <div>@Model.Usernames</div>
        }
    }
    else
    {
        <div>
            <p>@Resources.EnterListOfMemberUsernames <span class="red">*</span> @Resources.MaximumMembers</p>
            <textarea rows="3" class="txt-usernames" name="usernames"></textarea>
        </div>
    }

    <p style="margin-top: 10px;">@Resources.SelectThresholdPreset</p>
    <div class="form-group">
        <label class="lbl-threshold">@Resources.Preset</label>
        <select id="preset-dropdown" name="presetFilter" class="sel-preset">
            <option value="">@Resources.SelectPreset</option>
            @foreach (var preset in Model.PresetSelectionViewModel.Presets)
            {
                <option value="@preset.Value" @(preset.Selected ? " selected=\"selected\"" : string.Empty)>
                    @preset.Text
                </option>
            }
        </select>
    </div>

    @if (Model.IsEditWatchlistAccountsPopup)
    {
        @Html.Partial("~/Features/MyMonitorAccounts/MyWatchlistAccounts/Views/ThresholdInputGroup.cshtml", Model.Threshold)
        <button class="btn-submit" id="btn-update">@Resources.Update</button>
    }
    else
    {
        <div class="form-group">
            <label class="lbl-threshold">@Resources.WinningThreshold</label>
            <input class="txt-threshold text-right" type="text" name="winningThreshold" value="" maxlength="18" />
            <input id="winning-unlimited" class="ckb-unlimited" type="checkbox" name="winningUnlimited" value="" />
            <label for="winning-unlimited" class="lbl-unlimited">@Resources.Unlimited</label>
        </div>

        <div class="form-group">
            <label class="lbl-threshold">@Resources.LosingThreshold</label>
            <input class="txt-threshold text-right" type="text" name="losingThreshold" value="" maxlength="18" />
            <input id="losing-unlimited" class="ckb-unlimited" type="checkbox" name="losingUnlimited" value="" />
            <label for="losing-unlimited" class="lbl-unlimited">@Resources.Unlimited</label>
        </div>

        <button class="btn-submit" id="btn-add">@Resources.Add</button>
    }
</div>

@Html.AntiForgeryToken()

<input type="hidden" id="member-info-url" value='@MicroSites.MemberInfoUrl()'>
<input type="hidden" id="no-change-to-update-error" value="@Resources.NoChangeToUpdateError" />
<input type="hidden" id="add-successfully" value="@Resources.AddSuccessfully" />
<input type="hidden" id="update-successfully" value="@Resources.WatchlistUpdateSuccessfully" />
<input type="hidden" id="is-not-member-error" value="@Resources.IsNotMemberError" />
<input type="hidden" id="invalid-account-error" value="@Resources.InvalidAccountError" />
<input type="hidden" id="was-added-watchlist-already-error" value="@Resources.WasAddedWatchlistAlreadyError" />
<input type="hidden" id="must-enter-username-error" value="@Resources.MustEnterUsernameError" />
<input type="hidden" id="more-usernames-error" value="@Resources.MoreThan50UsernamesError" />

@if (Model.IsEditWatchlistAccountsPopup)
{
    <input type="hidden" id="old-winning-threshold" value="@Model.Threshold.WinningThreshold" />
    <input type="hidden" id="old-losing-threshold" value="@Model.Threshold.LosingThreshold" />
    <input type="hidden" id="usernames" value="@Model.Usernames" />
    <input type="hidden" id="custids" value="@Model.CustIds" />
}
else
{
    <input type="hidden" id="must-enter-threshold-or-check-error" value="@Resources.MustEnterThresholdOrCheckError" />
}

@section Scripts {
    @StaticResources.RenderScripts("~/Features/MyMonitorAccounts/MyWatchlistAccounts/Bundles/manage-watchlist-accounts")
}