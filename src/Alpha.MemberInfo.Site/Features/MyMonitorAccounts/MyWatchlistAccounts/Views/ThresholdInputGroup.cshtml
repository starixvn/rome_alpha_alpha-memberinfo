@model ThresholdViewModel

<div class="form-group">
    <label class="lbl-threshold">Winning Threshold</label>
    <input class="txt-threshold"
           type="text"
           name="winningThreshold"
           value="@(FormatThreshold(Model.WinningThreshold))"
           @(Model.WinningThreshold == null ? "disabled" : string.Empty)>
    <input class="ckb-unlimited" type="checkbox" name="winningUnlimited" @(Model.WinningThreshold == null ? "checked" : string.Empty) />
    <label class="lbl-unlimited">Unlimited</label>
</div>

<div class="form-group">
    <label class="lbl-threshold">Losing Threshold</label>
    <input class="txt-threshold"
           type="text"
           name="losingThreshold"
           value="@(FormatThreshold(Model.LosingThreshold))"
           @(Model.LosingThreshold == null ? "disabled" : string.Empty) />
    <input class="ckb-unlimited" type="checkbox" name="losingUnlimited" @(Model.LosingThreshold == null ? "checked" : string.Empty) />
    <label class="lbl-unlimited">Unlimited</label>
</div>

@helper FormatThreshold(decimal? number)
{
    if (number.HasValue)
    {
        @HtmlHelpers.FormatDecimal(number.Value);
    }
}