@using Newtonsoft.Json
@model MyWatchlistAccountsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.MyWatchlist;
}

@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode(
        "/bundles/site-memberinfo/daterangepicker",
        "/bundles/site-asset/data-table",
        $"/bundles/site-memberinfo/tab-{Model.CustLevel.ToLowerInvariant()}")
    @StaticResources.RenderStylesWithDarkMode("~/Features/MyWatchlist/Shared/Bundles/my-watchlist")
    @StaticResources.RenderStylesWithMedia(767, "~/Features/MyWatchlist/Shared/Bundles/my-watchlist-media")
}

@section Scripts {
    <script type="text/javascript">
        var watchlistAccountData = @Html.Raw(JsonConvert.SerializeObject(Model.MyWatchListAccountPagingViewModel, Formatting.None));
    </script>
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-memberinfo/daterangepicker")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-asset/data-table")
    @StaticResources.RenderScripts("~/Features/QRCodeMemberSignIn/Scripts/EasyAutocomplete/jquery.easy-autocomplete")
    @StaticResources.RenderScripts("~/Features/MyWatchlist/MyWatchlistAccounts/Bundles/my-watchlist-accounts")
}
<div class="my-watchlist-accounts">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation">
            @Html.ActionLink(Resources.ReachedThreshold, "Index", "ReachedThreshold")
        </li>
        <li role="presentation" class="active">
            <a href="javascript:;" aria-controls="home" role="tab" data-toggle="tab">@Resources.MyWatchlist</a>
        </li>
        <li role="presentation">
            @Html.ActionLink(Resources.MyThresholds, "Index", "MyThresholds")
        </li>
        @Html.Partial("~/Features/MyWatchlist/Shared/Views/InfoUserGuideTabs.cshtml", Model.UserGuideLink)
    </ul>
    <div class="ttl-box-watchlist">@Resources.WatchlistSummary</div>
    <div class="list-total-statement">
        <div class="item">
            <div class="title-total">@Resources.ActiveMembers</div>
            <div class="text-total">@HtmlHelpers.FormatNumber(Model.Summary.ActiveMembers)</div>
        </div>
        <div class="item">
            <div class="title-total">@Resources.MonitoredMembers</div>
            <div class="text-total">@HtmlHelpers.FormatNumber(Model.Summary.MonitoredMembers)</div>
        </div>
        <div class="item">
            <div class="title-total">@Resources.ReachedDailyLimitMembers</div>
            <div class="text-total">@HtmlHelpers.FormatNumber(Model.Summary.ReachedDailyLimitMembers)</div>
        </div>
        <div class="item last-item">
            <span class="title-total">@Resources.UnlimitedThresholdMembers</span>
            @if (Model.CanAddUnlimitedThresholdMembers)
            {
                <div class="text-total" id="summary-add-members" data-usernames="@Model.Summary.UnlimitedThresholdUsers" data-title="@Resources.ClickToSetThresholds">@HtmlHelpers.FormatNumber(Model.Summary.UnlimitedThresholdMembers)</div>
            }
            else
            {
                <div class="text-total">@HtmlHelpers.FormatNumber(Model.Summary.UnlimitedThresholdMembers)</div>
            }
        </div>
    </div>
    <div class="ttl-box-watchlist">@Resources.WatchlistDetail</div>
    @using (Html.BeginForm("GetWatchlistAccounts", "MyWatchlistAccounts", FormMethod.Post, new { @class = "form-inline filter form-report", id = "report-form" }))
    {
        @DateRangePickerJQuery.Render(Model.DateRangePicker);
        <div class="form-group">
            <label for="status-dropdown">@Resources.Status</label>
            @Html.DropDownList("status-dropdown", Model.Status, new { id = "status-dropdown" })
        </div>
        <div class="form-group">
            <label for="pa-dropdown">@Resources.ProblemAccount</label>
            @Html.DropDownList("pa-dropdown", Model.ProblemAccounts, new { id = "pa-dropdown" })
        </div>
        <div class="form-group username-box">
            <label class="label-form-control">@Resources.Username</label>
            <input type="text" class="txt-search" id="txt-username" placeholder="@Resources.Username" />
        </div>
        <div class="form-group">
            <input type="submit" value="@Resources.Submit" class="btn-submit" id="btn-submit" />
        </div>
        if (Model.CanUpdateAccount)
        {
            <div class="form-group">
                <button type="button" class="btn-default btn-manage-preset" id="btn-manage-preset">@Resources.PersonalThresholdPresets</button>
            </div>
            <div class="form-group">
                <button type="button" class="btn-default btn-global-threshold" id="btn-global-threshold">@Resources.GlobalThresholds</button>
            </div>
        }
    }
    @Html.Partial("~/Features/MyWatchlist/Shared/Views/GlobalThresholdsNote.cshtml", Model.GlobalThresholdModel, new ViewDataDictionary())
    <p class="note"><span class="star"></span>@Resources.UnlimitedThresholdNote</p>
    <div class="table-container">
        <div class="table-title">
            <div class="title">@Resources.MyWatchlist</div>
            @if (Model.CanUpdateAccount)
            {
                <div class="btn-box">
                    <button class="btn-submit" id="btn-add-members">@Resources.AddMember</button>
                </div>
            }
        </div>
        <table id="tblRpt" class="hidden tblRpt tblRpt-bordered tblRpt-hover display nowrap" style="width: 100%">
            <thead>
                <tr>
                    @if (!Model.IsMobile)
                    {
                        <th></th>
                    }
                    @if (Model.CanUpdateAccount)
                    {
                        <th></th>
                        <th></th>
                    }
                    <th></th>
                    @if (Model.IsShowLastLoginColumn)
                    {
                        <th></th>
                        <th></th>
                    }
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
                <tr>
                    @if (!Model.IsMobile)
                    {
                        <th class="header padding-icon">
                            @Resources.No
                        </th>
                    }
                    @if (Model.CanUpdateAccount)
                    {
                        <th class="header all padding-icon">
                            <input type="checkbox" class="select-all" id="select-all" />
                        </th>
                        <th class="header all padding-icon">
                            <div class="edit-multiple icon-table-edit" data-url="" title="Edit Multiple Setting" id="edit-multiple"></div>
                        </th>
                    }
                    <th class="header all username">@Resources.Username</th>
                    @if (Model.IsShowLastLoginColumn)
                    {
                        <th class="header desktop">@Resources.LastLogin</th>
                        <th class="header desktop">@Resources.AddedDate</th>
                    }
                    <th class="header desktop">@Resources.Status</th>
                    <th class="header desktop">@Resources.ProblemAccount</th>
                    <th class="header all winning">@Resources.WinningThreshold</th>
                    <th class="header all losing">@Resources.LosingThreshold</th>
                    <th class="header" style="width: 100px !important;"></th>
                </tr>
            </thead>
        </table>
    </div>
</div>
<div class="modal modal-sm fade" id="edit-popup" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            @if (Model.IsMobile)
            {
                <div class="modal-header">
                    <h5 class="modal-title"></h5>
                    <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="Close" id="close-edit-popup">
                        <span aria-hidden="true"></span>
                    </button>
                </div>
            }
            <div class="modal-body"></div>
        </div>
    </div>
</div>
@Html.Partial("~/Features/MyWatchlist/Shared/Views/InformationLegend.cshtml")
@Html.AntiForgeryToken()
<input type="hidden" id="search-account-id" value="@Model.SearchAccountId" />
<input type="hidden" id="is-mobile" value="@(Model.IsMobile ? "true" : "false")" />
<input type="hidden" id="can-update-account" value="@(Model.CanUpdateAccount ? "true" : "false")" />
<input type="hidden" id="member-info-url" value="@MicroSites.MemberInfoUrl()" />
<input type="hidden" id="edit-account-popup-title" value="@Resources.EditWatchlistAccount" />
<input type="hidden" id="manage-preset-popup-title" value="@Resources.PersonalThresholdPresetSettings" />
<input type="hidden" id="are-you-sure-to-remove-accounts" value="@Resources.AreYouSureToRemoveAccounts" />
<input type="hidden" id="edit-personal-threshold" value="@Resources.EditPersonalThreshold" />
<input type="hidden" id="remove-account" value="@Resources.RemoveAccount" />
<input type="hidden" id="edit-multiple-personal-threshold" value="@Resources.EditMultiplePersonalThresholds" />
<input type="hidden" id="remove-multiple-accounts" value="@Resources.RemoveMultipleAccounts" />
<input type="hidden" id="page-size" value="@Resources.PageSize" />
<input type="hidden" id="page" value="@Resources.Page" />
<input type="hidden" id="of" value="@Resources.Of" />
<input type="hidden" id="no-info" value="@Resources.NoInformationIsAvailable" />
<input type="hidden" id="is-show-last-login" value="@(Model.IsShowLastLoginColumn ? "true" : "false")" />
<input type="hidden" id="edit-text" value="@Resources.Edit" />
<input type="hidden" id="edit-multiple-text" value="@Resources.EditMultiple" />
