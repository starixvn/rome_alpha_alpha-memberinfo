@model ParlayMaxPayoutBasePageViewModel

<div id="pmp-container" class="pmp-container">
    <div id="message-container" class="message-container" style="display: none;">
        <div id="message-text" class="message message-icon"></div>
    </div>

    <div class="pmp-heading">@Model.SubText</div>
    <div class="pmp-content">
        <div class="pmp-setting-name"></div>
        <div class="pmp-setting-name single-match-parlay">@Model.SingleMatchParlayFieldText</div>
        <div class="pmp-setting-name combo-2">@Model.Combo2FieldText</div>
        <div class="pmp-setting-name combo-35">@Model.Combo35FieldText</div>
        <div class="pmp-setting-name combo-6-plus">@Model.ComboOver6FieldText</div>

        @RenderParlayMaxPayoutSetting(Model.Data)
    </div>
    <div class="pmp-footer">
        <button id="btn-submit" type="button" class="btn-submit">Update</button>
    </div>

    <div id="hint" class="hint" style="display: none;">
        <div id="hint-text"></div>
        <div id="hint-pointer" class="hint-pointer"></div>
    </div>

    @RenderHiddenFields()
</div>

@helper RenderHiddenFields()
{
    <input id="tb-updatesuccess-msg" type="hidden" value="@Model.UpdateSuccessfullyText" />
    <input id="tb-updateurl" type="hidden" value="@Url.Content(Model.UpdateUrl)" />
    <input id="tb-custidlist" type="hidden" value="@Model.CustIdList" />
    <input id="tb-custnamelist" type="hidden" value="@Model.CustNameList" />
    <input id="tb-invalidvalue-msg" type="hidden" value="@Model.InvalidMaxPayoutValueText" />
    <input id="tb-gtmaxvalue-msg" type="hidden" value="@Model.GreaterThanMaxValueText" />
}

@helper RenderParlayMaxPayoutSetting(IEnumerable<ParlayMaxPayoutViewModel> data)
{
    foreach (var item in data)
    {
        @RenderParlayMaxPayoutSettingRow(item)
    }
}

@helper RenderParlayMaxPayoutSettingRow(ParlayMaxPayoutViewModel item)
{
    var className = Model.GetClassName(item.SportTypeId);

    <div class="pmp-sport-name sport-name @className"
         data-bettypeid="@item.BetTypeId"
         data-bettypename="@item.BetTypeName"
         data-sporttypeid="@item.SportTypeId">
        @item.SportTypeName
    </div>

    var singleMatchParlayName = "SingleMatchParlay";
    var combo2Name = "Combo2";
    var combo35Name = "Combo35";
    var comboOver6Name = "ComboOver6";

    @RenderInputControl(item.SportTypeId, singleMatchParlayName, item.SingleMatchParlay, item.UplineSingleMatchParlay, Model.SingleMatchParlayFieldText)
    @RenderInputControl(item.SportTypeId, combo2Name, item.Combo2, item.UplineCombo2, Model.Combo2FieldText)
    @RenderInputControl(item.SportTypeId, combo35Name, item.Combo35, item.UplineCombo35, Model.Combo35FieldText)
    @RenderInputControl(item.SportTypeId, comboOver6Name, item.ComboOver6, item.UplineComboOver6, Model.ComboOver6FieldText)

    @RenderCheckBoxControl(item.SportTypeId, singleMatchParlayName, item.IsAllowUnlimitSingleMatchParlay)
    @RenderCheckBoxControl(item.SportTypeId, combo2Name, item.IsAllowUnlimitCombo2)
    @RenderCheckBoxControl(item.SportTypeId, combo35Name, item.IsAllowUnlimitCombo35)
    @RenderCheckBoxControl(item.SportTypeId, comboOver6Name, item.IsAllowUnlimitComboOver6)
}

@helper RenderInputControl(byte sportTypeId, string settingName, string value, string maxValue, string columnName)
{
    <div class="pmp-setting-control ctrl-input">
        <input type="text"
               maxlength="14"
               id="@settingName@sportTypeId"
               class="tb-setting"
               data-columnname="@columnName"
               data-sporttypeid="@sportTypeId"
               data-settingname="@settingName"
               data-currentvalue="@value"
               data-maxvalue="@maxValue"
               value="@value" />
    </div>
    <div class="pmp-setting-control ctrl-max-setting"><= @maxValue</div>
}

@helper RenderCheckBoxControl(byte sportTypeId, string settingName, bool isAllowUnlimit)
{
    <div class="pmp-setting-control ctrl-checkbox">
        @if (isAllowUnlimit)
        {
            <input type="checkbox"
                   class="cb-setting"
                   data-tbsettingid="@settingName@sportTypeId" />
        }
    </div>
    <div class="pmp-setting-control ctrl-checkbox-label">
        @(isAllowUnlimit ? "Unlimited" : "")
    </div>

}