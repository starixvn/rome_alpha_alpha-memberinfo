@model QRCodeMemberSignInViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

}
@{
    ViewBag.Title = "QR Code Member Sign In";
}
@section Styles {
    @StaticResources.RenderStyles("~/Features/QRCodeMemberSignIn/Bundles/qr-code-member-sign-in")
}
<div class="page-title">
    <span class="pull-left">CREATE MEMBER WITH QR CODE</span>
</div>
<div class="qr-code-member-sign-in">
    <div id="create-form">
        <div class="form-group">
            <label>Input Existing Member account (that you want to copy the setting)</label><br>
            <input type="text" id="txt-username" placeholder="" value="" />
        </div>
        <div class="form-group">
            <label>Member Credit</label><br>
            <input type="number" id="txt-member-credit" placeholder="" value="" />
        </div>
        <div class="form-group">
            <label>First Name (Optional)</label><br>
            <input type="text" id="txt-first-name" placeholder="" value="" />
        </div>
        <div class="form-group">
            <label>CAPTCHA</label><br>
            <input type="text" id="txt-captcha" placeholder="" value="" />
        </div>
        <div class="form-group">
            <button type="submit" class="btn-submit" id="btn-submit">Create Account</button>
        </div>
    </div>
    @{ Html.RenderPartial("~/Features/QRCodeMemberSignIn/Views/_CreateAccountSuccessfully.cshtml"); }
</div>

@section Scripts {
    @StaticResources.RenderScripts("~/Features/QRCodeMemberSignIn/Scripts/EasyAutocomplete/jquery.easy-autocomplete")
    @StaticResources.RenderScripts("~/Features/QRCodeMemberSignIn/Bundles/qr-code-member-sign-in")
}
