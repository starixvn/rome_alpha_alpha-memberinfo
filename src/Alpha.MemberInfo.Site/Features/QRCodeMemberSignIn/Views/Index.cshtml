@model QRCodeMemberSignInViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "QR Code Member Sign In";
    var errorMessageClass = string.IsNullOrEmpty(Model.ErrorMessage) ? "hidden" : "msg msg-error";
    var captchaSetting = new CaptchaSetting
    {
        Level = CaptchaLevels.Low,
        IsForm = false,
        IsShowButton = false,
        FunctionName = "QRCode"
    };
}
@section Styles {
    <link href="@Configuration.CaptchaStylesheet" rel="stylesheet" />
    @StaticResources.RenderStyles("~/Features/QRCodeMemberSignIn/Bundles/qr-code-member-sign-in")
}
@if (Model.ShowPageTitle)
{
    <div class="page-title">
        <span class="pull-left">@Resources.CreateMemberWithQRCode</span>
    </div>
}

<div id="qrCodeMemberSignInForm" class="form-inline filter">
    <div id="message" class="@errorMessageClass">
        <span id="message-content" className="col-xs-12">@Model.ErrorMessage</span>
    </div>
    <div id="create-form">
        <div class="form-group">
            <label>@Resources.InputExistingMemberAccount</label>
            <input type="text" name="UsernameCopyFrom" id="UsernameCopyFrom" placeholder="@Resources.UsernamePlaceHolder" value="@Model.MemberNameCopyFrom" />
            <span id="icon-message-UsernameCopyFrom" />
        </div>
        <div class="form-group">
            <label>@Resources.MemberCredit</label>
            <input type="text" name="Credit" id="Credit" placeholder="@Resources.PleaseInputMemberCredit" value="" />
            <span id="icon-message-credit"> </span>
            <div id="credit-range" class="hidden">
                <span id="credit-min-label"></span> <=  @Resources.NewGivenCredit <= <span id="credit-max-label"></span>
            </div>
        </div>
        <div class="form-group" id="username-group">
            <label>@Resources.Username</label>
            <span id="actor-name">@Model.ActorName</span>
            <select id="FirstSuffix" name="FirstSuffix">
                @foreach (var item in Model.NameSuffix)
                {
                    <option value="@item" @(Model.FirstChar.Equals(item) ? "selected=\"selected\"" : string.Empty)> @item</option>
                }
            </select>
            <select id="SecondSuffix" name="SecondSuffix">
                @foreach (var item in Model.NameSuffix)
                {
                    <option value="@item" @(Model.SecondChar.Equals(item) ? "selected=\"selected\"" : string.Empty)> @item</option>
                }
            </select>
            <select id="ThirdSuffix" name="ThirdSuffix">
                @foreach (var item in Model.NameSuffix)
                {
                    <option value="@item" @(Model.ThirdChar.Equals(item) ? "selected=\"selected\"" : string.Empty)> @item</option>
                }
            </select>
            <span id="icon-message-username" class="icon-check"/>
        </div>
        <div class="form-group">
            <label>@Resources.FirstNameOptional</label>
            <input type="text" name="FirstName" id="FirstName" value="" />
        </div>
        <div class="form-group">
            @Html.Captcha(captchaSetting)
        </div>
        <div class="form-group">
            <button type="submit" class="btn-submit" id="btn-submit">@Resources.CreateAccount</button>
        </div>
    </div>
    <input type="hidden" name="MemberAccountIsInvalid" id="MemberAccountIsInvalid" value="@Resources.MemberAccountIsInvalid" />
    @Html.HiddenFor(m => m.ShowPageTitle)
    @Html.HiddenFor(m => m.MemberNameCopyFrom)
    @Html.HiddenFor(m => m.ShowQRCodeLink)
    @Html.AntiForgeryToken()
</div>

@section Scripts {
    @StaticResources.AssetScripts.Render("/bundles/site-asset/numeral")
    @StaticResources.RenderScripts("~/Features/QRCodeMemberSignIn/Bundles/qr-code-member-sign-in")
}
