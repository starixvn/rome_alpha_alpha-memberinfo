@{
    ViewBag.Title = "Cash Balance Transfer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using Alpha.MemberInfo.Site.ViewModels.Transfer;
@model CashBalanceTransferViewModel

<div class="container-fluid cash-balance">
    <div class="section">
        <div class="row">
            <div class="col-xs-5 col-sm-3 col-lg-2 ex-text">@Model.UplineUserLevel.DisplayName Cash Balance:</div>
            <div class="col-xs-7 col-sm-9 col-lg-10">@HtmlHelpers.FormatNumber(Model.UplineCashBalance)</div>
        </div>
    </div>
    <div class="section">
        <div class="row">
            <div class="col-xs-12 ex-text">Master Information:</div>
        </div>
        <div class="row">
            <div class="col-xs-5 col-sm-3 col-lg-2">Username</div>
            <div class="col-xs-7 col-sm-9 col-lg-10">@Model.UserName</div>
        </div>
        <div class="row">
            <div class="col-xs-5 col-sm-3 col-lg-2">Cash Balance</div>
            <div class="col-xs-7 col-sm-9 col-lg-10">@HtmlHelpers.FormatNumber(Model.CashBalance)</div>
        </div>
        <div class="row">
            <div class="col-xs-5 col-sm-3 col-lg-2">Username</div>
            <div class="col-xs-7 col-sm-9 col-lg-10">@HtmlHelpers.FormatNumber(Model.Outstanding)</div>
        </div>
        <div class="row">
            <div class="col-xs-5 col-sm-3 col-lg-2">Given Credit</div>
            <div class="col-xs-7 col-sm-9 col-lg-10">@HtmlHelpers.FormatNumber(Model.GivenCredit)</div>
        </div>
    </div>
    <div class="section">
        <div class="row">
            <form class="form-inline col-xs-12" role="form">
                <div class="form-group">
                    <label>Amount</label>
                    <input type="text" class="textbox hasBorder" id="amount" name="amount">
                </div>
                <div class="form-group">
                    <input type="submit" class="btn-submit" value="Transfer" />
                </div>
            </form>
        </div>
        <div class="row">
            <div class="col-xs-12 note">You can transfer from @HtmlHelpers.FormatNumber(Model.TransferAmountFrom) to @HtmlHelpers.FormatNumber(Model.TransferAmountTo)</div>
        </div>
        
    </div>
</div>