@{
    ViewBag.Title = "Cash Balance Transfer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Alpha.MemberInfo.Site.ViewModels.Transfer;
@model CashBalanceTransferViewModel

<div class="container-fluid">
    <div class="row">
        <div class="col-md-1">@Model.UplineUserLevel.DisplayName Cash Balance:</div>
        <div class="col-md-11">@HtmlHelpers.FormatNumber(Model.UplineCashBalance)</div>
    </div>
    <div class="row">
        <div class="col-md-12">Master Information:</div>
    </div>
    <div class="row">
        <div class="col-md-1">Username</div>
        <div class="col-md-11">@Model.UserName</div>
    </div>
    <div class="row">
        <div class="col-md-1">Cash Balance</div>
        <div class="col-md-11">@HtmlHelpers.FormatNumber(Model.CashBalance)</div>
    </div>
    <div class="row">
        <div class="col-md-1">Username</div>
        <div class="col-md-11">@HtmlHelpers.FormatNumber(Model.Outstanding)</div>
    </div>
    <div class="row">
        <div class="col-md-1">Given Credit</div>
        <div class="col-md-11">@HtmlHelpers.FormatNumber(Model.GivenCredit)</div>
    </div>
    <div class="row">
        <form class="form-inline">
            <div class="form-group">
                <label for="amount">Amount</label>
                <input type="text" class="form-control" id="amount" name="amount">
            </div>
            <button type="submit" class="btn btn-submit">Transfer</button>
        </form>
    </div>
    <div class="row">
        <div class="col-md-12">You can transfer from @HtmlHelpers.FormatNumber(Model.TransferAmountFrom) to @HtmlHelpers.FormatNumber(Model.TransferAmountTo)</div>
    </div>
</div>