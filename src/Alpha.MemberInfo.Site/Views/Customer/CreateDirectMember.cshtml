@using Alpha.MemberInfo.Site.ViewModels.Customer;
@model CreateCustomerViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode($"/bundles/common/common-{Model.ActorLevel.DisplayName}")
    <link rel="stylesheet" href="http://localhost:4201/src/styles.scss" />
}

<div class="page-title">
    <span class="pull-left">@Resources.CreateDirectMember</span>
</div>

@if (Model.IsLimitNewDownline)
{
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane active">
            <div class="msg msg-error">
                <span className="col-xs-12">@Model.Message</span>
            </div>
        </div>
    </div>
}
else
{

    <div class="tab-content">
        <div role="tabpanel" class="tab-pane active">
            @Html.AntiForgeryToken()
            <input type="hidden" id="SecretKey" value="@Model.SecretKey" />
            <div id="root"></div>
        </div>
    </div>
    @section Scripts{
        <script type="module">
            import RefreshRuntime from "http://localhost:4201/@@react-refresh";
            RefreshRuntime.injectIntoGlobalHook(window);
            window.$RefreshReg$ = () => { };
            window.$RefreshSig$ = () => (type) => type;
            window.__vite_plugin_react_preamble_installed__ = true;
        </script>
        <script type="module" src=@("http://localhost:4201/@vite/client")></script>
        <script type="text/javascript">
        const appConfig = @Html.Raw(Model.AppConfig);
        const params = @Html.Raw(Model.Params);
        window.redirectToSettingPage = (response) => {
            const username = response.username;
            const custId = response.custId;
            const redirectUrl = '@MicroSites.OldMainUrl()' + "MemberInfo/RedirectPT.aspx?username=" + username + "&custid=" + custId
                + "&userId=" + @Model.ActorId + "&subAccId=" + @Model.SubAccId
                + "&isedit=false" + "&insert=true";
            window.location.replace(redirectUrl);
        };
        </script>
        <script type="module" src="http://localhost:4201/src/main.tsx"></script>
        @StaticResources.RenderScripts("~/assets/bundles/customer/create-customer")
    }
}