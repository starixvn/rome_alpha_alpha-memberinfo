@model ProductsViewModel

@*<div class="page-title">
        <span class="pull-left">@Resources.MemberRequest</span>
    </div>*@



<div id="page_main">
    <div id="header_main"><div>@Resources.MemberRequest</div></div>
</div>

<div id="box_header">
     <div class="msg msg-warning display-none">@Resources.EnabledMemberRequestsWarning</div>

    <form class="form-inline demo-form-inline filter" role="form">
        <div class="form-group">
            <select id="dropdown-product" name="dropdown-product">
                @foreach (var product in Model.Products)
                {
                    <option value="@product.Id" data-disabled="@product.Disabled" @(product.Id.Equals(Model.SelectedProductId) ? " selected=\"selected\"" : string.Empty)>@product.Name</option>
                }
            </select>

                @*@Html.DropDownListFor(model => model.SelectedProductId, Model.Products)
                @Html.ValidationMessageFor(model => model.SelectedProductId)*@
            </div>
        <div class="form-group">
            <input type="button" class="btn-default" value="Enable" disabled />
        </div>
    </form>
</div>

<div id="member-requests" action-url="@Url.Action("Members", "MemberRequests")">
</div>

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/member-requests/member-requests")
}