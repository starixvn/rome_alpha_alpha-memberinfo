@model MemberRequestViewModel

<div id="page_main">
    <div id="header_main"><div>@Resources.MemberRequest</div></div>
</div>

<div id="box_header">
    <div class="msg msg-warning">You're disabled on this product. Please contact upline to enable for you</div>
    @*<form class="form-inline demo-form-inline filter" role="form">
        <div class="form-group">
            <select id="product">
                <option value="0" selected="selected">Casino</option>
                <option value="1">Macau Games</option>
                <option value="2">Fishing World</option>
            </select>
        </div>
        
        <div class="form-group">
            <input type="button" class="btn-default" value="Enable" disabled />       
        </div>
    </form>*@

    <form class="form-inline demo-form-inline filter" role="form">
        <div class="form-group">
            @Html.DropDownListFor(model => model.SelectedProductId, Model.Products)
            @Html.ValidationMessageFor(model => model.SelectedProductId)
        </div>
        <div class="form-group">
            <input type="button" class="btn-default" value="Enable" disabled />
        </div>
    </form>
</div>

   

    @*<div class="page-title">
            <span class="pull-left">@Resources.MemberRequest</span>
        </div>*@

    @*<form class="form-inline filter" role="form" id="report-form">
                @ProductMultiSelection.Render(Model.ProductMultiSelectionViewModel)
        </form>*@

    <table id="tbl-report" class="tblRpt tblRpt-bordered tblRpt-hover tablesorter">
        <thead>
            <tr>
                <th>@Resources.No</th>
                <th><input type="checkbox" /></th>
                <th>@Resources.Username</th>
                <th>@Resources.Balance</th>
                <th>@Resources.Outstanding</th>
                <th>@Resources.AvailableCredit</th>
            </tr>
        </thead>


        @if (Model.MemberRequestData.Any())
        {
            int index = 1;
            <tbody>
                @foreach (var memberRequest in Model.MemberRequestData)
                {
                    <tr>
                        <td>@index</td>
                        <td><input type="checkbox" /></td>
                        <td>@memberRequest.Username</td>
                        <td>@memberRequest.Balance</td>
                        <td>@memberRequest.Outstanding</td>
                        <td>@memberRequest.AvailableCredit</td>
                    </tr>

                    index++;
                }
            </tbody>
        }
        else
        {
            @NoInformation.Render(6)
        }
    </table>
