@model ProductsViewModel

<div class="page-title">
    <span class="pull-left">@Resources.PlayForFunMemberRequest</span>
</div>

<div id="box_header">
    <div class="msg msg-info">
        @Resources.SettingRequiredWarning
    </div>
    <div id="msg-warning" class="msg msg-warning hide">
        @Resources.SettingRequiredWarning
    </div>

    <form class="form-inline demo-form-inline filter" role="form">
        @ProductSingleSelection.Render(Model.ProductMultiSelectionViewModel)
        <div class="form-group">
            <span id="icon-excel" class="icon-excel" title="@Resources.Refresh"></span>
        </div>
    </form>
</div>

<div id="member-requests" action-url="@Url.Action("Members", "MemberRequests")" />

@Html.Hidden("memberRequestRootUrl", Url.Action("Index", "MemberRequests"))
@Html.Hidden("disabledProductWarningMessage", Resources.DisabledProductWarning)
@Html.Hidden("noSettingWarning", Resources.NoSettingWarning)

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/member-requests/member-requests")
}