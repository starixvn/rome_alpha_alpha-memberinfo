@model MemberRequestViewModel

<div class="page-title">
    <span class="pull-left">Member Request</ span >
</div>

<form class="form-inline filter role="form" id="report-form">
    <div class="form-group">
        <input type="submit" value="Submit" class="btn-submit" />
    </div>
</form>


<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover tablesorter" >
    <thead>
        <tr>
            <th>No.</th>
            <th><input type="checkbox"/></th>
            <th>Username</th>
            <th>Balance</th>
            <th>Outstanding</th>
            <th>Available Credit</th>
        </tr>
    </thead>


    @if (Model.MemberRequestData.Any())
    {
        int index = 1;
        <tbody>
            @foreach (var memberRequest in Model.MemberRequestData)
            {
                <tr>
                    <td>@index</td>
                    <td><input type="checkbox" /></td>
                    <td>@memberRequest.Username</td>
                    <td>@memberRequest.Balance</td>
                    <td>@memberRequest.Outstanding</td>
                    <td>@memberRequest.AvailableCredit</td>
                </tr>

                index++;
            }
        </tbody>
    }
    else
    {
        @NoInformation.Render(6)
    }
</table>