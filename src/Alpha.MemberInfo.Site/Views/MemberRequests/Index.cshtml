@model MemberRequestViewModel

<div class="page-title">
    <span class="pull-left">@Resources.MemberRequest</ span >
</div>

<form class="form-inline filter role="form" id="report-form">
    @ProductMultiSelection.Render(Model.ProductMultiSelectionViewModel)
</form>

<table id="tbl-report" class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover tablesorter" >
    <thead>
        <tr>
            <th>@Resources.No</th>
            <th><input type="checkbox"/></th>
            <th>@Resources.Username</th>
            <th>@Resources.Balance</th>
            <th>@Resources.Outstanding</th>
            <th>@Resources.AvailableCredit</th>
        </tr>
    </thead>


    @if (Model.MemberRequestData.Any())
    {
        int index = 1;
        <tbody>
            @foreach (var memberRequest in Model.MemberRequestData)
            {
                <tr>
                    <td>@index</td>
                    <td><input type="checkbox" /></td>
                    <td>@memberRequest.Username</td>
                    <td>@memberRequest.Balance</td>
                    <td>@memberRequest.Outstanding</td>
                    <td>@memberRequest.AvailableCredit</td>
                </tr>

                index++;
            }
        </tbody>
    }
    else
    {
        @NoInformation.Render(6)
    }
</table>