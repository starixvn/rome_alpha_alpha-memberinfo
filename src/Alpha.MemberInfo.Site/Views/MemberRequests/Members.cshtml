@model MemberRequestViewModel
<table id="tbl-report" class="tblRpt tblRpt-bordered tblRpt-hover tablesorter">
    <thead>
        <tr>
            <th>@Resources.No</th>
            <th><input id="select-all" type="checkbox" @(Model.DisabledUserSelectedProduct ? "disabled" : string.Empty) /></th>
            <th class="text-left">@Resources.Username</th>
            <th>@Resources.Balance</th>
            <th>@Resources.Outstanding</th>
            <th>@Resources.AvailableCredit</th>
        </tr>
    </thead>


    @if (Model.MemberRequestData.Any())
    {
        int index = 1;
        <tbody>
            @foreach (var memberRequest in Model.MemberRequestData)
            {
                <tr>
                    <td class="text-center">@index</td>
                    <td class="text-center">
                        <input data-custId="@memberRequest.CustId"
                         data-username="@memberRequest.Username"
                         class="checkbox" type="checkbox"
                         @(!memberRequest.Sync || Model.DisabledUserSelectedProduct ? "disabled" : string.Empty) />
                    </td>
                    <td>
                        <a href="@Model.BuildProductSettingUrl(Model.SelectedProductId, memberRequest.CustId, memberRequest.Username)"
                           class="downline-link")>
                            @memberRequest.Username
                        </a>
                    </td>

                    @HtmlHelpers.RenderNumberCell(memberRequest.Balance)
                    @HtmlHelpers.RenderNumberCell(memberRequest.Outstanding)
                    @HtmlHelpers.RenderNumberCell(memberRequest.AvailableCredit)
                </tr>

                index++;
            }
        </tbody>
    }
    else
    {
        @NoInformation.Render(6)
    }
</table>

@helper FormatNumber(decimal value)
{
    @value.ToString($"#,##0.00")
}