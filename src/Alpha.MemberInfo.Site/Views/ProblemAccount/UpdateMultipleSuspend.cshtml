@using Alpha.MemberInfo.Site.ViewModels.ProblemAccount;
@{
    /**/
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/problem-account/update")
}
@model UpdateMultipleSuspendViewModel
<div class="content-page">
    <div id="message-container" class="message-container"></div>
    <form id="formUpdateMultipleSuspend" action="@MicroSites.AccountInfoUrl()UnsuspendDownlines/UnsuspendMultiple" method="post" class="formUpdateMultipleSuspend padding-top">
        @Html.AntiForgeryToken()
        <div class="review-content">
            @if (Model.DisplayShowAllAccountOption)
            {
                @Html.Raw(Model.ConfirmMessage)
                <span class="more-ellipses">...</span>
                <div class="more-content">
                    <span>@($", {string.Join(", ", Model.MoreDownlineUsernames)}")</span>
                    <a href="" class="more-link">@string.Format(Resources.ShowAllAccounts, Model.TotalAllAccount)</a>
                </div>
            }
            else
            {
                @Html.Raw($"{Model.ConfirmMessage}")
            }
        </div>

        @Html.Hidden(nameof(Model.Ids), Model.Ids)
        @Html.Hidden(nameof(Model.RoleId), Model.RoleId)
        @Html.Hidden(nameof(Model.UserNames), Model.UserNames)
        <div class="list-button">
            <input type="submit" class="btn-submit" value="@Resources.Submit" />
            <input type="button" class="btn-cancel" id="btnCancel" value="@Resources.Cancel" />
        </div>
    </form>
</div>
@Html.Hidden("SuccessMessage", Resources.UpdateSuccessfully)
@section Scripts{
    @StaticResources.RenderScripts("~/assets/bundles/problem-account/update-multiple-suspend")
}
