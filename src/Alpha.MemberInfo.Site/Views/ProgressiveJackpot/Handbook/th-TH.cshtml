@{
    Layout = null;
    var resourcePath = "~/Views/ProgressiveJackpot/Handbook/Styles";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>OneRNG Jackpot</title>
    <link type="text/css" href="@Url.Content($"{resourcePath}/page{ViewData["DarkModeName"]}.css")" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="container-heading1">
            <h1 class="heading1">แนะนำ</h1>
            <p class="mrg-t-4">
                Progressive Baccarat Jackpot ผู้เล่นสามารถวางเดิมพัน Side Bet เพื่อล่ารางวัลแจ็คพ็อตกลับบ้าน. เงินสะสมรางวัลแจ็คพ็อตจะแสดงที่หน้าจอด้านบน
            </p>
            <h1 class="heading1">กองทุนแจ๊คพ็อต</h1>
            <div class="container-heading2">
                <h2 class="heading2">ยอดกองทุน</h2>
                <p class="mrg-t-4">
                    ยอดของแจ๊คพ็อตในกองทุนรวมซึ่งแบ่งมาจากการวางเดิมพันและเปอร์เซ็นต์ความเสี่ยงของแต่ละ SMA และ บริษัท
                </p>
                <p>
                    ยอดกองทุน = {ค่าความเสี่ยง %} * {เรทกองทุน} * {มูลค่าตั๋วแจ๊คพ็อต}
                </p>
                <ul>
                    <li><strong>มูลค่าของตั๋วแจ๊คพ็อต</strong>: ยอดเดิมพันของแจ๊คพ็อตจำถูกกำหนดขึ้น</li>
                    <li><strong>กองทุนแจ๊คพ็อต</strong>: กองทุนนี้จะใช้สำหรับจ่ายรางวัล Progressive Jackpot</li>
                    <li><strong>อัตราเงินกองทุน</strong>: ตั๋วทุกใบจะถูกแบ่งเปอร์เซ็นต์ไปยังกองทุนแจ๊คพ็อต</li>
                </ul>
                <p class="bold">ตัวอย่าง:</p>
                <ul>
                    <li>เปอร์เซ็นต์ความเสี่ยงบนตัวลูกค้า =10%</li>
                    <li>เรทกองทุน = 5%</li>
                    <li>ยอดตั๋วแจ๊คพ็อต = $0.25</li>
                </ul>
                <p><span class="underline">หมายเหตุ</span>: ยอดกองทุนสมทบจะถูกปัดเศษทศนิยมเป็น 4 ตำแหน่ง</p>
                <p>&rarr; ยอดกองทุน = 10% * 5% * $0.25 = $0.00125 ≈ <strong>$0.0013</strong> </p>
                <h2 class="heading2">เงื่อนไขการชำระเงิน</h2>
                <table class="table">
                    <thead>
                        <tr>
                            <th>ชนิด</th>
                            <th>ความรับผิดชอบ</th>
                            <th>เคลียร์ตั๋ว</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>แจ๊คพ็อตใหญ่</td>
                            <td>บริษัท</td>
                            <td>
                                <ul class="list-style-disc">
                                    <li>ยอดสูงกว่าริงกิต(MYR) 200,000 : ติดต่อฝ่ายลูกค้าสัมพันธ์เพื่อขอรับเงินรางวัล</li>
                                    <li>ยอดต่ำกว่าริงกิต(MYR) 200,000 : เงินรางวัลจะโอนเข้าไปยังยูเซอร์ของลูกค้า</li>
                                    <li>ตั๋วที่วางพนันแจ๊คพ็อตไม่สามารถถูกยกเลิกได้</li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td>รางวัลอื่นๆ</td>
                            <td>บริษัท & ซูปเปอร์,มาสเตอร์, เอเย่น</td>
                            <td>
                                <ul class="list-style-disc">
                                    <li>เงินรางวัลจะโอนเข้าไปยังยูเซอร์ของลูกค้า</li>
                                    <li>ตั๋วที่วางพนันแจ๊คพ็อตสามารถทำการยกเลิกได้(รวมทั้งตั๋วที่จ่ายเงินแล้ว)</li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p class="bold">ตัวอย่าง:</p>
                <p>ยอดพนันแจ๊คพ็อต = 100; กองทุนแจ๊คพ็อต 5; เปอร์เซ็นแบ่งสู้ของซูปเปอร์,มาสเตอร์, เอเย่น = 90%; เปอร์เซ็นแบ่งสู้ของบริษัท = 10%</p>
                <ul class="list-style-disc">
                    <li>
                        <p>กรณีที่ 1 - สมาชิกแพ้ตั๋วพนันแจ๊คพ็อต</p>
                        <img src="@Url.Content($"{resourcePath}/images/th/case-1.png")" alt="Case 1" title="Case 1">
                    </li>
                    <li>
                        <p>กรณีที่ 2 - สมาชิกชนะรางวัล 10 เท่า (10Xตั๋วพนันแจ๊คพ็อต)</p>
                        <img src="@Url.Content($"{resourcePath}/images/th/case-2.png")" alt="Case 2" title="Case 2">
                    </li>
                    <li>
                        <p>กรณีที่ 3 - สมาชิกชนะรางวัลแจ๊คพ็อตใหญ่</p>
                        <img src="@Url.Content($"{resourcePath}/images/th/case-3.png")" alt="Case 3" title="Case 3">
                    </li>
                </ul>
            </div>
        </div>
    </div>
</body>
</html>
