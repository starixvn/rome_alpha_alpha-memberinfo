@{
    Layout = null;
    var resourcePath = "~/Views/ProgressiveJackpot/Handbook/Styles";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>OneRNG Jackpot</title>
    @StaticResources.RenderStylesWithDarkMode($"{resourcePath}/page")
</head>
<body>
    <div class="container">
        <div class="container-heading1">
            <h1 class="heading1">Giới thiệu</h1>
            <p class="mrg-t-4">
                Người chơi có thể đặt một cược phụ vào Jackpot Luỹ Tiến và mang về cho mình cơ hội thắng giải thưởng Jackpot giá trị. Giá trị giải thưởng Jackpot sẽ được hiển thị phía trên màn hình.
            </p>
            <h1 class="heading1">Tích luỹ Jackpot</h1>
            <div class="container-heading2">
                <h2 class="heading2">Tiền tích luỹ</h2>
                <p class="mrg-t-4">
                    Tiền trong quỹ Jackpot sẽ được tích luỹ theo tỷ lệ phần trăm (%) các cấp SMA và House thu được từ cược Jackpot của người chơi, tính theo Position Taking tương ứng.
                </p>
                <p>
                    Tiền tích luỹ = {Position Taking %} * {Mức tích luỹ} * {Tiền cược Jackpot}
                </p>
                <ul>
                    <li><strong>Tiền cược Jackpot</strong>: số tiền để tham gia cược Jackpot.</li>
                    <li><strong>Quỹ Jackpot</strong>: quỹ dùng để chi trả cho giải thưởng Jackpot Luỹ Tiến.</li>
                    <li><strong>Mức tích luỹ</strong>: lượng tiền cược (%) được dùng để chuyển vào quỹ Jackpot.</li>
                </ul>
                <p class="bold">Ví dụ:</p>
                <ul>
                    <li>Position Taking trên người chơi = 10%</li>
                    <li>Mức tích luỹ = 5%</li>
                    <li>Tiền cược Jackpot = $0.25</li>
                </ul>
                <p><span class="underline">Lưu ý</span>: tiền tích luỹ sẽ được làm tròn đến 4 số lẻ.</p>
                <p>&rarr;  Tiền tích luỹ = 10% * 5% * $0.25 = $0.00125 ≈ <strong>$0.0013</strong> </p>
                <h2 class="heading2">Quy định về trả thưởng</h2>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Giải thưởng</th>
                            <th>Chịu trách nhiệm</th>
                            <th>Tiền trả thưởng</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Mega Jackpot</td>
                            <td>House</td>
                            <td>
                                <ul class="list-style-disc">
                                    <li>Hơn 200,000 MYR: liên hệ với bộ phận Chăm Sóc Khách Hàng để lãnh thưởng.</li>
                                    <li>200,000 MYR hoặc ít hơn: tiền thưởng sẽ được chuyển vào tài khoản của người chơi.</li>
                                    <li>Tiền cược Jackpot sẽ KHÔNG được hoàn lại.</li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td>Các giải khác</td>
                            <td>House & SMA</td>
                            <td>
                                <ul class="list-style-disc">
                                    <li>Tiền trúng thưởng sẽ được chuyển vào tài khoản của người chơi.</li>
                                    <li>Tiền cược Jackpot sẽ được hoàn lại (gộp chung vào số tiền trúng thưởng).</li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p class="bold">Ví dụ:</p>
                <p>Tiền cược Jackpot = 100; Tiền tích luỹ = 5; SMA PT = 90%; House PT = 10%</p>
                <ul class="list-style-disc">
                    <li>
                        <p>Trường hợp 1 - Người chơi thua cược :</p>
                        <img src="@Url.Content($"{resourcePath}/images/vn/case-1.png")" alt="Case 1" title="Case 1">
                    </li>
                    <li>
                        <p>Trường hợp 2 - Người chơi thắng giải thưởng nhân 10 (tiền cược Jackpot x 10 lần) :</p>
                        <img src="@Url.Content($"{resourcePath}/images/vn/case-2.png")" alt="Case 2" title="Case 2">
                    </li>
                    <li>
                        <p>Trường hợp 3 - Người chơi thắng giải Mega Jackpot :</p>
                        <img src="@Url.Content($"{resourcePath}/images/vn/case-3.png")" alt="Case 3" title="Case 3">
                    </li>
                </ul>
            </div>
        </div>
    </div>
</body>
</html>
