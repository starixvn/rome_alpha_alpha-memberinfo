@{
    Layout = null;
    var resourcePath = "~/Views/ProgressiveJackpot/Handbook/Styles";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>OneRNG Jackpot</title>
    <link type="text/css" href="@Url.Content($"{resourcePath}/page.css")" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="container-heading1">
            <h1 class="heading1">介绍</h1>
            <p class="mrg-t-4">
                累积积宝百家乐允许玩家旁观下注并有机会获得累积积宝。
                此积宝的累积数额会显示于屏幕的上方。
            </p>
            <h1 class="heading1">积宝贡献</h1>
            <div class="container-heading2">
                <h2 class="heading2">贡献数额</h2>
                <p class="mrg-t-4">
                    积宝池的大小是基于旁观下注的%总额由SMA和公司贡献取决于占成数设置。
                </p>
                <p>
                    贡献金额 = {占称数 %} * {贡献比率} * {积宝投注值}
                </p>
                <ul>
                    <li><strong>积宝赌注值</strong>： 在投注积宝游戏时所需的固定金额。</li>
                    <li><strong>积宝池</strong>： 此奖池是支付累积积宝的奖金。</li>
                    <li><strong>贡献率</strong>：每一注的百分率将进入积宝奖金</li>
                </ul>
                <p class="bold">例子:</p>
                <ul>
                    <li>在会员的占成数 = 10%</li>
                    <li>总贡献比率 = 5%</li>
                    <li>积宝投注值 = $0.25</li>
                </ul>
                <p><span class="underline">注意</span>: 贡献金额将会以四个小数点净值。</p>
                <p>&rarr; 贡献金额 = 10% * 5% * $0.25 = $0.00125 ≈ <strong>$0.0013</strong> </p>
                <h2 class="heading2">支付条件</h2>
                <table class="table">
                    <thead>
                        <tr>
                            <th>类型</th>
                            <th>负责</th>
                            <th>派彩</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>积宝奖金</td>
                            <td>公司</td>
                            <td>
                                <ul class="list-style-disc">
                                    <li>超过马币200,000：需与客服部联系以领取赢额。</li>
                                    <li>马币200,000或以下：赢额将转至会员的账户。</li>
                                    <li>积宝赌注金额将不予退还。</li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td>其他奖品</td>
                            <td>公司 & 超级总代理， 总代理， 代理</td>
                            <td>
                                <ul class="list-style-disc">
                                    <li>赢额将转至会员的账户。</li>
                                    <li>积宝赌注金额将会退还 （包含在派彩内）</li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p class="bold">例子:</p>
                <p>积宝赌注值 = 100； 积宝贡献 = 5； 超级总代，总代 及 代理 占成数 = 90%; 公司 占成数 = 10%</p>
                <ul class="list-style-disc">
                    <li>
                        <p>案例1 - 玩家输了积宝赌注：</p>
                        <img src="styles/images/cn/case-1.png" alt="Case 1" title="Case 1">
                        <img src="@Url.Content($"{resourcePath}/images/cn/case-1.png")" alt="Case 1" title="Case 1">
                    </li>
                    <li>
                        <p>案例2 - 玩家赢10倍奖金 （10 x 积宝赌注值）： </p>
                        <img src="@Url.Content($"{resourcePath}/images/cn/case-2.png")" alt="Case 2" title="Case 2">
                    </li>
                    <li>
                        <p>案例3 - 玩家赢得积宝奖金 :</p>
                        <img src="@Url.Content($"{resourcePath}/images/cn/case-3.png")" alt="Case 3" title="Case 3">
                    </li>
                </ul>
            </div>
        </div>
    </div>
</body>
</html>
