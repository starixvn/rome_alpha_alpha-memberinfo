@{
    Layout = null;
    var resourcePath = "~/Views/ProgressiveJackpot/Handbook/Styles";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>OneRNG Jackpot</title>
    <link type="text/css" href="@Url.Content($"{resourcePath}/page{ViewData["DarkModeName"]}.css")" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="container-heading1">
            <h1 class="heading1">介紹</h1>
            <p class="mrg-t-4">
                累積積寶百家樂允許玩家旁觀下注並有機會獲得累積積寶。
                此積寶的累積數額會顯示於屏幕的上方。
            </p>
            <h1 class="heading1">積寶貢獻</h1>
            <div class="container-heading2">
                <h2 class="heading2">貢獻數額</h2>
                <p class="mrg-t-4">
                    積寶池的大小是基於旁觀下注的%總額由SMA和公司貢獻取決於佔成數設置。
                </p>
                <p>
                    貢獻金額 = {佔稱數 %} * {貢獻比率} * {積寶投注值}
                </p>
                <ul>
                    <li><strong>積寶賭注值</strong>： 在投注積寶遊戲時所需的固定金額。</li>
                    <li><strong>積寶池</strong>： 此獎池是支付累積積寶的獎金。</li>
                    <li><strong>貢獻率</strong>：每一注的百分率將進入積寶獎金</li>
                </ul>
                <p class="bold">例子:</p>
                <ul>
                    <li>在會員的佔成數 = 10%</li>
                    <li>總貢獻比率 = 5%</li>
                    <li>積寶投注值 = $0.25</li>
                </ul>
                <p><span class="underline">注意</span>：貢獻金額將會以四個小數點淨值。</p>
                <p>&rarr; 貢獻金額 = 10% * 5% * $0.25 = $0.00125 ≈ <strong>$0.0013</strong> </p>
                <h2 class="heading2"> 支付條件</h2>
                <table class="table">
                    <thead>
                        <tr>
                            <th>類型</th>
                            <th>負責</th>
                            <th>派彩</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>積寶獎金</td>
                            <td>公司</td>
                            <td>
                                <ul class="list-style-disc">
                                    <li>超過馬幣200,000：需與客服部聯繫以領取贏額。</li>
                                    <li>馬幣200,000或以下：贏額將轉至會員的賬戶。</li>
                                    <li>積寶賭注金額將不予退還。</li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td>其他獎品</td>
                            <td>公司 & 超級總代理， 總代理， 代理</td>
                            <td>
                                <ul class="list-style-disc">
                                    <li>贏額將轉至會員的賬戶。</li>
                                    <li>積寶賭注金額將會退還 （包含在派彩內）</li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p class="bold">例子:</p>
                <p>積寶賭注值 = 100； 積寶貢獻 = 5； 超級總代，總代 及 代理 佔成數 = 90%; 公司 佔成數 = 10%</p>
                <ul class="list-style-disc">
                    <li>
                        <p>案例1 - 玩家輸了積寶賭注：</p>
                        <img src="@Url.Content($"{resourcePath}/images/tw/case-1.png")" alt="Case 1" title="Case 1">
                    </li>
                    <li>
                        <p>案例2 - 玩家贏10倍獎金 （10 x 積寶賭注值）：</p>
                        <img src="@Url.Content($"{resourcePath}/images/tw/case-2.png")" alt="Case 2" title="Case 2">
                    </li>
                    <li>
                        <p>案例3 - 玩家贏得積寶獎金 :</p>
                        <img src="@Url.Content($"{resourcePath}/images/tw/case-3.png")" alt="Case 3" title="Case 3">
                    </li>
                </ul>
            </div>
        </div>
    </div>
</body>
</html>
