<appSettings>
  <add key="vs:EnableBrowserLink" value="false" />
  <add key="ClientValidationEnabled" value="true" />
  <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />

  <add key="StoredProcedurePath" value="App_Data/SPNames/Local"/>
  <add key="IndirectLoginURL" value="http://nex3-i1.nexdev.net/ex-main/"/>
  <add key="CreateNewAccount:MaxAccountPerRequest" value="10"/>
  <add key="CustomerApi:Uri" value="http://customer.nexdev.net/main/"/>
</appSettings>