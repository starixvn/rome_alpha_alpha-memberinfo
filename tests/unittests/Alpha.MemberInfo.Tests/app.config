<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Caching" type="Fanex.Caching.Configuration.CacheSettings, Fanex.Caching" />
    
    <section name="couchbase" type="Couchbase.Configuration.CouchbaseClientSection, Couchbase" />
  <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" /></configSections>
  <couchbase>
    <servers bucket="Alpha" bucketPassword="">
      <add uri="http://10.18.200.103:8091/pools/default" />
    </servers>
  </couchbase>
  <Fanex.Caching cacheType="Fanex.Caching.Memory.MemoryCache, Fanex.Caching">
    <connectionSettings>
      <add name="CompactOnMemoryPressure" value="true" />
      <add name="ExpirationScanFrequency" value="1" />
    </connectionSettings>
  </Fanex.Caching>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="NSubstitute" publicKeyToken="92dd2e9066daa5ca" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.2.0" newVersion="2.0.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.0" newVersion="9.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  
<Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" filePath="$FilePath" /></configuration>
